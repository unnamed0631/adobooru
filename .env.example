# Copy this file to .env and fill in the secrets:
#   cp .env.example .env
# Generate values with e.g. `openssl rand -hex 24`.
#
# The orchestrator container overrides ADOBORU_DATA_DIR, SZURU_API_URL,
# SZURU_CONTENT_BASE_URL, TAGGING_POLICY, TWITTER_COOKIES, REDIS_URL and
# ORCHESTRATOR_HOST internally.  The values below are what a host-side CLI
# run would use, so the same .env works in both places.

COMPOSE_PROJECT_NAME=adobooru

# ── Published ports ────────────────────────────────────────────────────────
SZURU_WEB_PORT=8080
SZURU_API_PORT=6666
ORCHESTRATOR_PORT=8081

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=szurubooru
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=szurubooru

SZURU_THREADS=4
SZURU_LOG_SQL=0

# ── Szurubooru API credentials ─────────────────────────────────────────────
# Create a dedicated user in the web UI, then create an API token under
# User settings -> API tokens.  The token is shown only once.
# The default upload path needs the "regular" rank (uploads:create and
# tags:create); contentUrl mode also needs "uploads:use_downloader", which
# config/szurubooru-server.yaml relaxes to regular.
SZURU_USERNAME=adobooru-bot
SZURU_TOKEN=

# "off"   - never query existing posts by source
# "warn"  - query and log a match, but let content hashes decide (recommended:
#           one tweet/album can contain several distinct images)
# "skip"  - skip a candidate when its source already exists (faster, but can
#           drop additional images from multi-image posts)
SZURU_SOURCE_LOOKUP=warn
# Exact SHA-1 checksum lookup + server-side reverse search.
SZURU_SERVER_DEDUPE=true
SZURU_MIN_INTERVAL=0.25

# ── HTTP behaviour ─────────────────────────────────────────────────────────
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=4
HTTP_BACKOFF_BASE=1.5
HTTP_BACKOFF_CAP=60
MAX_DOWNLOAD_MB=64

# ── Danbooru ───────────────────────────────────────────────────────────────
# Danbooru uses "ado_(utaite)" (a copyright tag).  The prompt's
# "ado_(utaitor)" spelling returns zero posts on Danbooru (verified); it is
# still mapped as a tag alias in config/tagging.yaml for legacy data.
DANBOORU_QUERY=ado_(utaite)
DANBOORU_LIMIT=40
DANBOORU_MAX_PAGES=2
DANBOORU_MIN_INTERVAL=1.1
# Let Szurubooru download Danbooru files itself.  Faster and lighter on this
# service, but disables SHA-256/pHash dedupe for those posts.
DANBOORU_CONTENT_URL_MODE=false
DANBOORU_CRON="0 */6 * * *"
# Optional authenticated Danbooru access (higher rate limits):
# DANBOORU_LOGIN=
# DANBOORU_API_KEY=

# ── X / Twitter ────────────────────────────────────────────────────────────
# Comma-separated URLs, #hashtags, @handles or bare handles.
TWITTER_TARGETS="https://x.com/hashtag/AdoArt?f=media"
# TWITTER_PROFILES=artist_handle
TWITTER_LIMIT=50
TWITTER_FALLBACK=auto
TWITTER_INCLUDE_VIDEOS=false
TWITTER_MAX_SCROLLS=8
TWITTER_CRON="30 */4 * * *"
GALLERY_DL_TIMEOUT=300
# Exported Netscape cookie jar (see secrets/README.md).  Compose overrides
# this with /secrets/cookies.txt.
TWITTER_COOKIES=./secrets/cookies.txt
# Only for public profiles; search/hashtags normally require a session.
TWITTER_ALLOW_ANONYMOUS=false
# Adds ~400 MB to the image.  Required for the Playwright fallback.
WITH_PLAYWRIGHT=false

# ── AI tagging ─────────────────────────────────────────────────────────────
TAGGER_ENABLED=true
# Fail the X run instead of uploading default-only tags when the model cannot
# be loaded.
TAGGER_REQUIRED=false
# TAGGING_POLICY is set to /etc/adobooru/tagging.yaml in compose.  For host
# runs the default is config/tagging.yaml if that file exists.
PHASH_THRESHOLD=5
ALLOWED_SAFETY=safe,sketchy,unsafe
EXTRA_TAGS=

# ── Orchestrator API / scheduler ───────────────────────────────────────────
# Empty means no authentication; the port is only bound to 127.0.0.1.
# Set this if you expose the API through a reverse proxy.
ORCHESTRATOR_API_KEY=
SCHEDULER_TIMEZONE=UTC
LOG_LEVEL=INFO
